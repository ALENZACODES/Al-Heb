# Cloudflare Pages headers for ALEF (copied into dist/ by tools/deploy/make-dist.mjs; checked by tools/deploy/check-deploy.mjs).
# Cloudflare rules: when several rules match one URL ALL their headers apply, and a header set twice is joined with a comma.
# So Cache-Control is set only in rules that do not overlap; /* carries security headers only.
# Limits (developers.cloudflare.com/pages/platform/limits, read 2026-11-03): 100 header rules, 2,000 characters per header.
#
# CSP: ALEF is zero-dependency, so every source is 'self'. Notes:
#  - style-src 'unsafe-inline': views set style="" attributes from JavaScript and offline.html has a <style> block.
#  - script-src 'wasm-unsafe-eval': the vendored Tesseract OCR core (assets/vendor/_tesseract) is WebAssembly.
#  - worker-src blob: and img-src/media-src blob: data: : OCR worker, photo canvas, picked photos.
#  - connect-src also allows http://127.0.0.1:* and http://localhost:* : the optional "local translation helper" on the learner's own computer.
#  - The OPTIONAL online vowel service (nakdan-u2-1a.loadbalancer.dicta.org.il, off by default, src/photo/engines/web.js) is a third
#    party and is therefore BLOCKED by this CSP: that feature cannot work on this host unless its origin is added to connect-src.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=(), usb=(), bluetooth=(), serial=(), interest-cohort=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

# Content type that static hosts often get wrong (installability needs the manifest to parse as JSON).
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Always revalidate: the service worker, the generated precache list (its hash is the cache version), and the entry pages.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/offline.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/precache-manifest.js
  Cache-Control: no-cache

# App code, styles and data keep stable (un-hashed) file names, so they are NOT immutable: revalidate with the ETag (a 304 is cheap).
# The service worker precaches them anyway, and a new precache-manifest.js version replaces the cache.
/src/*
  Cache-Control: no-cache
/data/*
  Cache-Control: no-cache
/assets/css/*
  Cache-Control: no-cache

# Binary assets that rarely change: one week. If a file is replaced, give it a new name.
/assets/fonts/*
  Cache-Control: public, max-age=604800
/assets/icons/*
  Cache-Control: public, max-age=604800
/assets/screenshots/*
  Cache-Control: public, max-age=604800
/assets/img/*
  Cache-Control: public, max-age=604800
/assets/vendor/*
  Cache-Control: public, max-age=604800
/assets/workbook/*
  Cache-Control: public, max-age=604800
/audio/*
  Cache-Control: public, max-age=604800

# Reserved for the day assets get content-hashed names (nothing is hashed today, so nothing matches yet):
# /assets/h/*
#   Cache-Control: public, max-age=31536000, immutable
