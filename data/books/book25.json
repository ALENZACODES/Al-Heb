   "hasAudio": false
  },
  {
   "n": 6,
   "he": "\"שָׁלוֹם, אֲנִי נוּרִית. שְׁבִי.\"",
   "translit": "\"Shalom, ani Nurit. Shvi.\"",
   "en": "\"Hello, I'm Nurit. Sit.\"",
