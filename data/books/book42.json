  {
   "n": 4,
   "he": "\"לְאָן?\"",
   "translit": "\"Le'an?\"",
   "en": "\"Where to?\"",
   "img": "assets/books/book42/BOOK42_p04.jpg",
   "audio": {
    "f": "audio/f/israeli/book/book42-p04.mp3",
    "m": "audio/m/israeli/book/book42-p04.mp3"
   },
   "illustration": "the driver looking in the mirror",
   "hasImg": false,
   "hasAudio": false
  },
  {
   "n": 5,
   "he": "\"לִשְׂדֵה הַתְּעוּפָה.\"",
   "translit": "\"Li-sdeh ha-te'ufah.\"",
   "en": "\"To the airport.\"",
   "img": "assets/books/book42/BOOK42_p05.jpg",
   "audio": {
    "f": "audio/f/israeli/book/book42-p05.mp3",
    "m": "audio/m/israeli/book/book42-p05.mp3"
   },
   "illustration": "a suitcase on her lap",
   "hasImg": false,
   "hasAudio": false
  },
  {
   "n": 6,
   "he": "\"טִיסָה?\"",
   "translit": "\"Tisah?\"",
   "en": "\"A flight?\"",
   "img": "assets/books/book42/BOOK42_p06.jpg",
   "audio": {
    "f": "audio/f/israeli/book/book42-p06.mp3",
    "m": "audio/m/israeli/book/book42-p06.mp3"
   },
   "illustration": "the driver pulling out",
   "hasImg": false,
   "hasAudio": false
  },
  {
   "n": 7,
   "he": "\"כֵּן. אֲנִי עוֹזֶבֶת.\"",
   "translit": "\"Ken. Ani ozevet.\"",
   "en": "\"Yes. I'm leaving.\"",
   "img": "assets/books/book42/BOOK42_p07.jpg",
   "audio": {
    "f": "audio/f/israeli/book/book42-p07.mp3",
    "m": "audio/m/israeli/book/book42-p07.mp3"
   },
   "illustration": "the woman looking out at the passing city",
   "hasImg": false,
   "hasAudio": false
  },
  {
   "n": 8,
   "he": "\"לְכַמָּה זְמַן?\"",
   "translit": "\"Le-kamah zman?\"",
   "en": "\"For how long?\"",
   "img": "assets/books/book42/BOOK42_p08.jpg",
   "audio": {
    "f": "audio/f/israeli/book/book42-p08.mp3",
    "m": "audio/m/israeli/book/book42-p08.mp3"
   },
   "illustration": "the driver's eyes in the mirror",
   "hasImg": false,
   "hasAudio": false
  },
  {
   "n": 9,
   "he": "\"אֲנִי לֹא יוֹדַעַת.\"",
   "translit": "\"Ani lo yoda'at.\"",
   "en": "\"I don't know.\"",
   "img": "assets/books/book42/BOOK42_p09.jpg",
   "audio": {
    "f": "audio/f/israeli/book/book42-p09.mp3",
    "m": "audio/m/israeli/book/book42-p09.mp3"
