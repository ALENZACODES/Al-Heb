  {
   "id": "d-cafe",
   "track": "israel",
   "title": "At the cafe",
   "topic": "ordering food and drink",
   "level": "A1",
   "unlockAfter": "il07",
   "setting": "A woman orders a coffee and a cake at a cafe counter.",
   "proofread": false,
   "speakers": [
    {
     "id": "a",
     "name": "Waiter (man)"
    },
    {
     "id": "b",
     "name": "Dana (woman)"
    }
   ],
   "lines": [
    {
     "id": "d-cafe-l1",
     "speaker": "a",
     "he": "שָׁלוֹם! מָה תִּרְצִי?",
     "translit": "shalom! ma tirtsi?",
     "en": "Hello! What would you like?"
    },
    {
     "id": "d-cafe-l2",
     "speaker": "b",
     "he": "אֲנִי רוֹצָה קָפֶה הָפוּךְ, בְּבַקָּשָׁה.",
     "translit": "ani rotsa kafe hafuch, bevakasha.",
     "en": "I'd like a cafe hafuch (a milky coffee), please."
    },
    {
     "id": "d-cafe-l3",
     "speaker": "a",
     "he": "עוֹד מַשֶּׁהוּ?",
     "translit": "od mashehu?",
     "en": "Anything else?"
    },
    {
     "id": "d-cafe-l4",
     "speaker": "b",
     "he": "כֵּן, גַּם עוּגָה. כַּמָּה זֶה?",
     "translit": "ken, gam uga. kama ze?",
     "en": "Yes, a cake too. How much is it?"
    },
    {
     "id": "d-cafe-l5",
     "speaker": "a",
     "he": "אַרְבָּעִים וּשְׁמוֹנָה שְׁקָלִים.",
     "translit": "arba'im ushmone shekalim.",
     "en": "Forty-eight shekels."
    },
    {
     "id": "d-cafe-l6",
     "speaker": "b",
     "he": "אֶפְשָׁר בְּכַרְטִיס?",
     "translit": "efshar bekartis?",
     "en": "Can I pay by card?"
    },
    {
     "id": "d-cafe-l7",
     "speaker": "a",
     "he": "בֶּטַח. תּוֹדָה רַבָּה!",
     "translit": "betach. toda raba!",
     "en": "Of course. Thanks a lot!"
    }
   ]
  },
  {
   "id": "d-restaurant",
   "track": "israel",
   "title": "A table for two",
   "topic": "ordering food",
   "level": "A2",
   "unlockAfter": "il09",
   "setting": "Two people get a table, order, and ask for the bill.",
   "proofread": false,
   "speakers": [
    {
     "id": "a",
     "name": "Host and waiter (woman)"
    },
    {
     "id": "b",
     "name": "Guest (man)"
    }
   ],
   "lines": [
    {
     "id": "d-restaurant-l1",
     "speaker": "a",
     "he": "שָׁלוֹם. לְכַמָּה אֲנָשִׁים?",
     "translit": "shalom. lekama anashim?",
     "en": "Hello. For how many people?"
    },
    {
     "id": "d-restaurant-l2",
     "speaker": "b",
     "he": "לִשְׁנַיִם, בְּבַקָּשָׁה.",
     "translit": "lishnayim, bevakasha.",
     "en": "For two, please."
    },
    {
     "id": "d-restaurant-l3",
     "speaker": "a",
     "he": "בְּבַקָּשָׁה, פֹּה. הִנֵּה הַתַּפְרִיט.",
     "translit": "bevakasha, po. hine hatafrit.",
     "en": "Please, here. Here is the menu."
    },
    {
     "id": "d-restaurant-l4",
     "speaker": "b",
     "he": "אֲנִי רוֹצֶה שְׁנִיצֶל וְסָלָט.",
     "translit": "ani rotse shnitsel vesalat.",
     "en": "I'd like a schnitzel and a salad."
    },
    {
     "id": "d-restaurant-l5",
     "speaker": "a",
     "he": "וְלִשְׁתּוֹת?",
     "translit": "velishtot?",
     "en": "And to drink?"
    },
    {
     "id": "d-restaurant-l6",
     "speaker": "b",
     "he": "מַיִם, בְּבַקָּשָׁה.",
     "translit": "mayim, bevakasha.",
     "en": "Water, please."
    },
    {
     "id": "d-restaurant-l7",
     "speaker": "b",
     "he": "סְלִיחָה, אֶפְשָׁר אֶת הַחֶשְׁבּוֹן?",
     "translit": "slicha, efshar et hacheshbon?",
     "en": "Excuse me, can I have the bill?"
    },
    {
     "id": "d-restaurant-l8",
     "speaker": "a",
     "he": "בֶּטַח, רֶגַע.",
     "translit": "betach, rega.",
     "en": "Sure, one moment."
    }
   ]
  },
  {
   "id": "d-directions",
   "track": "israel",
   "title": "Where is the bus station?",
   "topic": "directions",
   "level": "A2",
   "unlockAfter": "il11",
   "setting": "A tourist asks a passer-by for the way.",
   "proofread": false,
   "speakers": [
    {
     "id": "a",
     "name": "Tourist (man)"
    },
    {
     "id": "b",
     "name": "Passer-by (woman)"
    }
   ],
   "lines": [
    {
     "id": "d-directions-l1",
     "speaker": "a",
     "he": "סְלִיחָה, אֵיפֹה הַתַּחֲנָה הַמֶּרְכָּזִית?",
     "translit": "slicha, eifo hatachana hamerkazit?",
     "en": "Excuse me, where is the central station?"
    },
    {
     "id": "d-directions-l2",
     "speaker": "b",
     "he": "לֵךְ יָשָׁר, וְאַחַר כָּךְ פְּנֵה שְׂמֹאלָה.",
     "translit": "lech yashar, ve'achar kach pne smola.",
     "en": "Go straight, and then turn left."
    },
    {
     "id": "d-directions-l3",
     "speaker": "a",
     "he": "זֶה רָחוֹק?",
     "translit": "ze rachok?",
     "en": "Is it far?"
    },
    {
     "id": "d-directions-l4",
     "speaker": "b",
     "he": "לֹא, חָמֵשׁ דַּקּוֹת.",
     "translit": "lo, chamesh dakot.",
     "en": "No, five minutes."
    },
    {
     "id": "d-directions-l5",
     "speaker": "a",
     "he": "תּוֹדָה רַבָּה!",
     "translit": "toda raba!",
     "en": "Thank you very much!"
    },
    {
     "id": "d-directions-l6",
     "speaker": "b",
     "he": "בְּבַקָּשָׁה.",
     "translit": "bevakasha.",
     "en": "You're welcome."
    }
   ]
  },
  {
   "id": "d-smalltalk",
   "track": "israel",
   "title": "Nice to meet you",
   "topic": "small talk",
   "level": "A2",
   "unlockAfter": "il13",
   "setting": "Two people meet at a party and chat.",
   "proofread": false,
   "speakers": [
    {
     "id": "a",
     "name": "Yossi (man)"
    },
    {
     "id": "b",
     "name": "Maya (woman)"
    }
   ],
   "lines": [
    {
     "id": "d-smalltalk-l1",
     "speaker": "a",
     "he": "הַיי, מָה נִשְׁמָע?",
     "translit": "hai, ma nishma?",
     "en": "Hi, how's it going?"
    },
    {
     "id": "d-smalltalk-l2",
     "speaker": "b",
     "he": "הַכֹּל בְּסֵדֶר, תּוֹדָה. וְאַתָּה?",
     "translit": "hakol beseder, toda. ve'ata?",
     "en": "All fine, thanks. And you?"
    },
    {
     "id": "d-smalltalk-l3",
     "speaker": "a",
     "he": "הַכֹּל טוֹב. מֵאֵיפֹה אַתְּ?",
     "translit": "hakol tov. me'eifo at?",
     "en": "All good. Where are you from?"
    },
    {
     "id": "d-smalltalk-l4",
     "speaker": "b",
     "he": "אֲנִי מִתֵּל אָבִיב. וְאַתָּה?",
     "translit": "ani mitel aviv. ve'ata?",
     "en": "I'm from Tel Aviv. And you?"
    },
    {
     "id": "d-smalltalk-l5",
     "speaker": "a",
     "he": "אֲנִי מִקָּנָדָה. אֲנִי מְדַבֵּר עִבְרִית קְצָת.",
     "translit": "ani mikanada. ani medaber ivrit ktsat.",
     "en": "I'm from Canada. I speak a little Hebrew."
    },
    {
     "id": "d-smalltalk-l6",
     "speaker": "b",
     "he": "מְצֻיָּן! אַתָּה מְדַבֵּר טוֹב.",
     "translit": "metsuyan! ata medaber tov.",
     "en": "Excellent! You speak well."
    },
    {
     "id": "d-smalltalk-l7",
     "speaker": "a",
     "he": "נָעִים מְאוֹד.",
     "translit": "na'im me'od.",
     "en": "Very nice to meet you."
    }
   ]
  },
