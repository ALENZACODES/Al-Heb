"source":{"file":"data/curriculum/lessons.json","ref":"I-23/words","channel":"curriculum"}},"flags":["exampleSpellingShared","needsReview"]},{"id":"h7e5cc0c5","kind":"word","he":"עֲבוֹדָה","heUnpointed":"עבודה","translit":"avodah","en":"worship, service","pos":"noun","gender":"f","forms":{"plural":"עֲבוֹדוֹת","feminine":"עֲבוֹדָה"},"frequencyRank":507,"corpusRank":616,"corpusOccurrences":3,"level":"A1","track":"both","example":{"he":"עַל הַתּוֹרָה וְעַל הָעֲבוֹדָה וְעַל הַנְּבִיאִים וְעַל יוֹם הַשַּׁבָּת הַזֶּה שֶׁנָּתַתָּ לָּנוּ יְהוָה אֱלֹהֵינוּ לִקְדֻשָּׁה וְלִמְנוּחָה לְכָבוֹד וּלְתִפְאָרֶת עַל הַכֹּל יְהוָה אֱלֹהֵינוּ אֲנַחְנוּ מוֹדִים לָךְ וּמְבָרְכִים אוֹתָךְ יִתְבָּרַךְ שִׁמְךָ בְּפִי כָּל־חַי תָּמִיד לְעוֹלָם וָעֶד בָּרוּךְ אַתָּה יְהוָה מְקַדֵּשׁ הַשַּׁבָּת אָמֵן׃","en":"For the Torah, and for the service, and for the prophets, and for this Shabbat day which you gave us, LORD our God, for holiness and rest, for honour and glory. For all this, LORD our God, we thank you and bless you. May your name be blessed by every living being, always, for ever. Blessed are you, LORD, who makes the Shabbat holy.","match":"clitic","senseChecked":false,"source":{"file":"data/corpus/registry.json","ref":"haftarah-after","channel":"corpus"}},"flags":[]},{"id":"h5dbeb151","kind":"word","he":"אֲוִיר","heUnpointed":"אויר","translit":"avir","en":"air","pos":"noun","gender":"m","forms":{"plural":"אֲוִירִים"},"frequencyRank":705,"corpusRank":621,"corpusOccurrences":3,"level":"A2","track":"israel","example":{"he":"דֹּאַר אֲוִיר","en":"air mail","match":"pointed","senseChecked":false,"source":{"file":"data/curriculum/lessons.json","ref":"I-22/words","channel":"curriculum"}},"flags":[]},{"id":"hc7778ee0","kind":"word","he":"רֻפָּא","heUnpointed":"רפא","translit":"rupa","en":"to be healed, to be cured","pos":"verb","gender":null,"forms":{"present":"מְרֻפָּא","future":"יְרֻפָּא"},"frequencyRank":938,"corpusRank":628,"corpusOccurrences":3,"level":"A2","track":"both","example":{"he":"אֵ