ּחָה לְכָבוֹד וּלְתִפְאָרֶת עַל הַכֹּל יְהוָה אֱלֹהֵינוּ אֲנַחְנוּ מוֹדִים לָךְ וּמְבָרְכִים אוֹתָךְ יִתְבָּרַךְ שִׁמְךָ בְּפִי כָּל־חַי תָּמִיד לְעוֹלָם וָעֶד בָּרוּךְ אַתָּה יְהוָה מְקַדֵּשׁ הַשַּׁבָּת אָמֵן׃","en":"For the Torah, and for the service, and for the prophets, and for this Shabbat day which you gave us, LORD our God, for holiness and rest, for honour and glory. For all this, LORD our God, we thank you and bless you. May your name be blessed by every living being, always, for ever. Blessed are you, LORD, who makes the Shabbat holy.","match":"clitic","senseChecked":false,"source":{"file":"data/corpus/registry.json","ref":"haftarah-after","channel":"corpus"}},"flags":[]},{"id":"h6c2b8669","kind":"word","he":"גּוּף","heUnpointed":"גוף","translit":"guf","en":"a body","pos":"noun","gender":"m","forms":{"plural":"גּוּפִים"},"frequencyRank":516,"corpusRank":536,"corpusOccurrences":2,"level":"A1","track":"israel","example":{"he":"אֵין לוֹ דְמוּת הַגּוּף וְאֵינוֹ גוּף לֹא נַעֲרֹךְ אֵלָיו קְדֻשָּׁתוֹ׃","en":"He has no bodily form and is not a body; his holiness cannot be compared.","match":"clitic","senseChecked":false,"source":{"file":"data/corpus/registry.json","ref":"yigdal","channel":"corpus"}},"flags":[]},{"id":"he527093f","kind":"word","he":"חֹם","heUnpointed":"חם","translit":"chom","en":"Heat, warmth","pos":"noun","gender":"m","forms":null,"frequencyRank":517,"corpusRank":537,"corpusOccurrences":2,"level":"A1","track":"both","example":{"he":"חַם לִי","en":"I'm hot","match":"exact","senseChecked":false,"source":{"file":"data/corpus/phrasebook.json","ref":"small-talk-12","channel":"corpus"}},"flags":["exampleSpellingShared","needsReview"]},{"id":"h87f1b5a9","kind":"word","he":"זָכָר","heUnpointed":"זכר","translit":"zakhar","en":"man, male","pos":"noun","gender":"m","forms":{"plural":"זְכָרִים"},"frequencyRank":535,"corpusRank":539,"corpusOccurrences":2,"level":"A1","track":"both","example":{"he":"בָּרוּךְ אַתָּה יְהוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו וְרָצָה בָנוּ וְשַׁבַּת קָדְשׁוֹ בְּאַהֲבָה וּבְרָצוֹן הִנְחִילָנוּ זִכָּרוֹן לְמַעֲשֵׂה בְרֵאשִׁית כִּי הוּא יוֹם תְּחִלָּה לְמִקְרָאֵי קֹדֶשׁ זֵכֶר לִיצִיאַת מִצְרָיִם כִּי בָנוּ בָחַרְתָּ וְאוֹתָנוּ קִדַּשְׁתָּ מִכָּל הָעַמִּים וְשַׁבַּת קָדְשְׁךָ בְּאַהֲבָה וּבְרָצוֹן הִנְחַלְתָּנוּ בָּרוּךְ אַתָּה יְהוָה מְקַדֵּשׁ הַשַּׁבָּת׃","en":"Blessed are you, LORD our God, king of the world, who made us holy with his commandments and was pleased with us, and in love and favour gave us his holy Shabbat as an inheritance, a remembrance of the work of creation. For it is the first of the holy convocations, a remembrance of the exodus from Egypt. For you chose us and made us holy from all the peoples, and in love and favour you gave us your holy Shabbat as an inheritance. Blessed are you, LORD, who makes the Shabbat holy.","match":"exact","senseChecked":false,"source":{"file":"data/corpus/registry.json","ref":"kiddush-shabbat-eve","channel":"corpus"}},"flags":["exampleSpellingShared","needsReview"]},{"id":"h06788e83","kind":"word","he":"זִמֵּר","heUnpointed":"זמר","translit":"zimer","en":"to sing","pos":"verb","gender":null,"forms":{"present":"מְזַמֵּר","future":"יְזַמֵּר","infinitive":"לְזַמֵּר"},"frequencyRank":2275,"corpusRank":626,"corpusOccurrences":2,"level":"B1","track":"both","example":{"he":"טוֹב לְהֹדוֹת לַיהוָה, וּלְזַמֵּר לְשִׁמְךָ עֶלְיוֹן.","en":"It is good to give thanks to the Eternal and to sing to Your name.","match":"clitic","senseChecked":false,"source":{"file":"data/curriculum/prompts.json","ref":"m05","channel":"curriculum"}},"flags":["exampleSpellingShared"]},{"id":"h788c5f0a","kind":"word","he":"עֶצֶם","heUnpointed":"עצם","translit":"etzem","en":"bone","pos":"noun","gender":"f","forms":{"plural":"עֲצָמוֹת","feminine":"עֶצֶם"},"frequencyRank":105,"corpusRank":741,"corpusOccurrences":1,"level":"A1","track":"both","example":null,"flags":["noCorpusExample","needsReview"]},{"id":"h761c6cb9","kind":"word","he":"זָהָב","heUnpointed":"זה