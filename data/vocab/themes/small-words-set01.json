evel":"A1","track":"read","example":{"he":"וְהָיוּ הַדְּבָרִים הָאֵלֶּה אֲשֶׁר אָנֹכִי מְצַוְּךָ הַיּוֹם עַל־לְבָבֶךָ׃","en":"And these words, which I command thee this day, shall be upon thy heart;","match":"pointed","senseChecked":false,"source":{"file":"data/corpus/registry.json","ref":"vahavta-2","channel":"corpus"}},"flags":["needsReview"]},{"id":"h16d29b05","kind":"word","he":"אַחַר","heUnpointed":"אחר","translit":"achar","en":"after","pos":"prep","gender":null,"forms":null,"frequencyRank":470,"corpusRank":204,"corpusOccurrences":8,"level":"A1","track":"both","example":{"he":"לֵךְ יָשָׁר, וְאַחַר כָּךְ פְּנֵה שְׂמֹאלָה.","en":"Go straight, and then turn left.","match":"clitic","senseChecked":false,"source":{"file":"data/curriculum/dialogues.json","ref":"d-directions-l2","channel":"curriculum"}},"flags":["exampleSpellingShared","needsReview"]},{"id":"h62c2a993","kind":"word","he":"תַּחַת","heUnpointed":"תחת","translit":"tachat","en":"below","pos":"prep","gender":null,"forms":null,"frequencyRank":167,"corpusRank":225,"corpusOccurrences":7,"level":"A1","track":"both","example":{"he":"עָלֵינוּ לְשַׁבֵּחַ לַאֲדוֹן הַכֹּל לָתֵת גְּדֻלָּה לְיוֹצֵר בְּרֵאשִׁית שֶׁלֹּא עָשָׂנוּ כְּגוֹיֵי הָאֲרָצוֹת וְלֹא שָׂמָנוּ כְּמִשְׁפְּחוֹת הָאֲדָמָה שֶׁלֹּא שָׂם חֶלְקֵנוּ כָּהֶם וְגוֹרָלֵנוּ כְּכָל־הֲמוֹנָם שֶׁהֵם מִשְׁתַּחֲוִים לָהֶבֶל וָרִיק וּמִתְפַּלְּלִים אֶל־אֵל לֹא יוֹשִׁיעַ וַאֲנַחְנוּ מִשְׁתַּחֲוִים לִפְנֵי מֶלֶךְ מַלְכֵי הַמְּלָכִים הַקָּדוֹשׁ בָּרוּךְ הוּא שֶׁהוּא נוֹטֶה שָׁמַיִם וְיוֹסֵד אָרֶץ וּמוֹשַׁב יְקָרוֹ בַּשָּׁמַיִם מִמַּעַל וּשְׁכִינַת עֻזּוֹ בְּגָבְהֵי מְרוֹמִים הוּא אֱלֹהֵינוּ וְאֵין עוֹד אַחֵר אֱמֶת מַלְכֵּנוּ וְאֶפֶס זוּלָתוֹ כַּכָּתוּב בַּתּוֹרָה וְיָדַעְתָּ הַיּוֹם וַהֲשֵׁבֹתָ אֶל־לְבָבֶךָ כִּי יְהוָה הוּא הָאֱלֹהִים בַּשָּׁמַיִם מִמַּעַל וְעַל־הָאָרֶץ מִתָּחַת אֵין עוֹד׃","en":"It is our duty to praise the Master of all, to ascribe greatness to the Creator of the beginning: that he has not made us like the nations of the lands and has not placed us like the families of the earth, that he has not set our portion like theirs nor our lot like all their multitude. For they bow to vanity and emptiness and pray to a god who does not save; but we bow before the King of kings of kings, the Holy One, blessed be he, who stretches out the heavens and founds the earth, whose seat of glory is in the heavens above and the presence of his might in the loftiest heights. He is our God; there is no other. Truly he is our king; there is nothing besides him. As it is written in the Torah: \"You shall know this day and take it to heart that the LORD is God, in the heavens above and on the earth beneath; there is no other.\"","match":"clitic","senseChecked":false,"source":{"file":"data/corpus/registry.json","ref":"aleinu-1","channel":"corpus"}},"flags":["needsReview"]},{"id":"h42de5b1f","kind":"word","he":"אַשְׁרֵי","heUnpointed":"אשרי","translit":"ashrei","en":"happy is/was/will be","pos":"prep","gender":null,"forms":null,"frequencyRank":1408,"corpusRank":239,"corpusOccurrences":7,"level":"A2","track":"read","example":{"he":"אַשְׁרֵי יוֹשְׁבֵי בֵיתֶךָ עוֹד יְהַלְלוּךָ סֶּלָה׃","en":"Happy are they that dwell in Thy house, they are ever praising Thee. Selah","match":"pointed","senseChecked":false,"source":{"file":"data/corpus/registry.json","ref":"ashrei-84-5","channel":"corpus"}},"flags":[]},{"id":"h04345345","kind":"word","he":"פִּי","heUnpointed":"פי","translit":"pi","en":"Multiplicative particle","pos":"particle","gender":null,"forms":null,"frequencyRank":388,"corpusRank":269,"corpusOccurrences":6,"level":"A1","track":"both","example":{"he":"יִהְיוּ לְרָצוֹן אִמְרֵי פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ יְהוָה צוּרִי וְגוֹאֲלִי׃","en":"May the words of my mouth and the thoughts of my heart be acceptable before you, LORD, my rock and my redeemer.","match":"pointed","senseChecked":false,"source":{"file":"data/corpus/registry.json","ref":"amidah-yihyu","channel":"corpus"}},"flags":["needsReview"]},{"id":"he9919e02","kind":"word","he":"לְ־"