+/** The one voice and style the shipped synthetic clips exist for (data/audio/manifest*.json: voice m, tradition israeli). */
+export const ALT_CLIP = Object.freeze({ voice: 'm', tradition: 'israeli' });
+/** Is there a clip for this item in ANOTHER voice/tradition than the learner's setting? Returns the access result for it, or null. Never throws. */
+export function altClipAccess(audio, kind, id) {
+  try {
+    const s = audio && typeof audio.status === 'function' ? audio.status(kind, id, { ...ALT_CLIP }) : null;
+    return s && s.source === 'file' ? { level: 'file', label: fileLabel(s.entryStatus, s.fileTradition || s.tradition, s.entrySource) } : null;
+  } catch { return null; }
+}
