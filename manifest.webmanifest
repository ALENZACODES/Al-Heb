{
  "name": "Aleph",
  "short_name": "Aleph",
  "description": "A free Hebrew reading and speaking course for synagogue readers and Israel travellers. Works offline. Content is a draft, not yet reviewed by a Hebrew teacher or clergy.",
  "start_url": "./#/",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f6efe0",
  "theme_color": "#16301c",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education"],
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Lessons", "short_name": "Lessons", "url": "./#/learn", "description": "Open the lesson list" },
    { "name": "Review cards", "short_name": "Review", "url": "./#/learn?review=1", "description": "Practise the cards that are due" },
    { "name": "Letters", "short_name": "Letters", "url": "./#/letters", "description": "Trace and look up the letters" },
    { "name": "Read", "short_name": "Read", "url": "./#/torahread", "description": "Torah and prayer reading" },
    { "name": "Speak", "short_name": "Speak", "url": "./#/speak", "description": "Say Hebrew aloud" }
  ],
  "screenshots": [
    { "src": "assets/screens/narrow-home.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Home: today's lesson" },
    { "src": "assets/screens/narrow-lesson.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "A review card" },
    { "src": "assets/screens/narrow-letters.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Letters atlas" },
    { "src": "assets/screens/narrow-torah-line.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Torah reading ladder (draft)" },
    { "src": "assets/screens/narrow-speak.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Say it: speaking practice (draft)" },
    { "src": "assets/screens/wide-home.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Home on a wide screen" },
    { "src": "assets/screens/wide-letters.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Letters atlas on a wide screen" },
    { "src": "assets/screens/wide-vocab.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Vocabulary theme packs (draft)" }
  ]
}
